DATABASE_URL=postgresql+asyncpg://interview:change-me@postgres:5432/interview_assistant
REDIS_URL=redis://redis:6379/0
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MURF_API_KEY=
ASSEMBLYAI_API_KEY=
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
SUBMIT_ANSWER_RATE_LIMIT=10/minute
# Comma-separated list of frontend origins allowed to call this API from a browser
CORS_ORIGINS=http://localhost:5173

# Read by the postgres container in docker-compose; keep in sync with DATABASE_URL
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview_assistant
